{
  "name": "console-launcher",
  "version": "2.3.14",
  "description": "Lanceur de jeux plein écran façon menu de console",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win dir",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "local.console.launcher",
    "productName": "Console Launcher",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "tools-src",
          "to": "tools"
        },
        {
          "from": "emulators-src/win",
          "to": "emulators"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "emulators-src/linux",
          "to": "emulators"
        }
      ],
      "category": "Game"
    },
    "extraResources": [
      {
        "from": "recipes",
        "to": "recipes"
      },
      {
        "from": "covers-src",
        "to": "covers"
      },
      {
        "from": "backdrops-src",
        "to": "backdrops"
      }
    ]
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
